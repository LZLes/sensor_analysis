# Local dev: point at your local Postgres.
# Production: Render's Blueprint (render.yaml) wires this automatically
# from its own free Postgres instance. If you swap to another provider
# (e.g. Neon) later, paste its connection string as-is — app/config.py
# rewrites a bare "postgresql://" scheme to "postgresql+psycopg://"
# automatically, since most providers' dashboards give the bare scheme
# and psycopg3 needs the +psycopg driver suffix.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sensor_analysis
SESSION_SECRET=replace-with-a-long-random-string
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ANTHROPIC_API_KEY=sk-ant-...
FRONTEND_ORIGIN=http://localhost:5173
