# Local dev: point at your local Postgres, or a free Neon branch.
# Production: Neon gives you a "postgresql://...?sslmode=require" URL —
# paste it as-is, app/config.py rewrites the postgresql:// scheme to
# postgresql+psycopg:// automatically (Neon's dashboard copy button gives
# the bare scheme; psycopg3 needs the +psycopg driver suffix).
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sensor_analysis
SESSION_SECRET=replace-with-a-long-random-string
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ANTHROPIC_API_KEY=sk-ant-...
FRONTEND_ORIGIN=http://localhost:5173
